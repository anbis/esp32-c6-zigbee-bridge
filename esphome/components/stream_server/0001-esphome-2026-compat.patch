Fix build against ESPHome 2026.x: drop get_use_address() from dump_config()

ESPHome 2026.x removed esphome::network::get_use_address(). Upstream
stream_server still calls it in dump_config(), so the component fails to
compile. The call is log-only, so it is simply dropped and the listening
port is logged instead.

Apply against oxan/esphome-stream-server @ master:
    patch -p1 < 0001-esphome-2026-compat.patch

--- a/components/stream_server/stream_server.cpp
+++ b/components/stream_server/stream_server.cpp
@@ -49,9 +49,9 @@
 void StreamServerComponent::dump_config() {
     ESP_LOGCONFIG(TAG, "Stream Server:");
 #if ESPHOME_VERSION_CODE >= VERSION_CODE(2025, 11, 0)
-    ESP_LOGCONFIG(TAG, "  Address: %s:%u", esphome::network::get_use_address(), this->port_);
+    ESP_LOGCONFIG(TAG, "  Port: %u", this->port_);
 #else
-    ESP_LOGCONFIG(TAG, "  Address: %s:%u", esphome::network::get_use_address().c_str(), this->port_);
+    ESP_LOGCONFIG(TAG, "  Port: %u", this->port_);
 #endif
 #ifdef USE_BINARY_SENSOR
     LOG_BINARY_SENSOR("  ", "Connected:", this->connected_sensor_);
